# GAMEVAULT Production Environment Variables
# ----------------------------------------

# RAWG API Key: Get your key from https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here

# Admin Token: Secret token for catalog controls (auto-generated if omitted)
GAMEVAULT_ADMIN_TOKEN=your_secure_admin_secret_token

# Database Path: SQLite file path (use a persistent volume path like /data/playscape.sqlite3 in production)
GAMEVAULT_DB=playscape.sqlite3

# Host: Bind host (0.0.0.0 binds to all network interfaces)
GAMEVAULT_HOST=0.0.0.0

# Port: Dynamic port assigned by hosting provider ($PORT on Render/Railway/Heroku)
PORT=10000

# CORS Origin: Allowed public HTTPS domain (e.g. https://your-app.onrender.com or * for all)
GAMEVAULT_CORS_ORIGIN=*
